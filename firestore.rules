rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /history/{docId} {
      allow read, write: if request.auth != null && resource == null || (resource != null && resource.data.uid == request.auth.uid);
    }
    match /knowledge_graphs/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
